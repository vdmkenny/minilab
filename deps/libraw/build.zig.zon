.{
    .name = .libraw,
    // LibRaw's release 0.22.2: the tag 0.22.2, commit b93f6e45c194f5df9b02a43b1af9a54b4f41f33f.
    .version = "0.22.2",
    .fingerprint = 0x2e0b4671c34638c5,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .upstream = .{
            .url = "git+https://github.com/LibRaw/LibRaw.git?ref=0.22.2#b93f6e45c194f5df9b02a43b1af9a54b4f41f33f",
            .hash = "N-V-__8AAFHDLADSspIaqcSSll5_5l76B5uWrExkG90pq0kF",
        },
        // zlib 1.3.2, for floating-point DNG. libtiff pins the same one, so only one is linked.
        .zlib = .{
            .url = "git+https://github.com/allyourcodebase/zlib.git?ref=1.3.2#d3b5519d3b73616a6bfece0712f080029d2a9244",
            .hash = "zlib-1.3.2-ZZQ7lc8NAAAHm9MDfplvwoesXvk4tVm6VCsiI8KnIbT0",
        },
        // libjpeg-turbo, for lossy DNG and Kodak DC120.
        .libjpeg_turbo = .{ .path = "../libjpeg-turbo" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
    },
}
