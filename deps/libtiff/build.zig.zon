.{
    .name = .libtiff,
    // LibTIFF's release 4.7.2: the tag v4.7.2, commit d01a94be176f5f6a87f7ee1c0b32e65416aa2b4d.
    .version = "4.7.2",
    .fingerprint = 0x295e4c787412fdc2,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .upstream = .{
            .url = "git+https://gitlab.com/libtiff/libtiff.git?ref=v4.7.2#d01a94be176f5f6a87f7ee1c0b32e65416aa2b4d",
            .hash = "N-V-__8AAMJ7gABNncsG5aHnm-gdrT0-5rj1TjFHa7qrN0jm",
        },
        // zlib 1.3.2, for Deflate and PixarLog, as OpenReliant pins it.
        .zlib = .{
            .url = "git+https://github.com/allyourcodebase/zlib.git?ref=1.3.2#d3b5519d3b73616a6bfece0712f080029d2a9244",
            .hash = "zlib-1.3.2-ZZQ7lc8NAAAHm9MDfplvwoesXvk4tVm6VCsiI8KnIbT0",
        },
        // libjpeg-turbo, for JPEG and old-style JPEG in TIFF.
        .libjpeg_turbo = .{ .path = "../libjpeg-turbo" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
    },
}
