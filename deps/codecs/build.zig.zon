.{
    .name = .codecs,
    .version = "0.1.0",
    .fingerprint = 0x59444db6f6beb64d,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // translate-c turns `c.h` into the module.
        .translate_c = .{
            .url = "git+https://codeberg.org/ziglang/translate-c?ref=2.0.0#0da7a16c3235b935b82421646076e0657cda21f6",
            .hash = "translate_c-2.0.0-Q_BUWltOBwA0229IE8wwSxxGzOxyRso3hvcb1nN8oJX_",
        },
        .libtiff = .{ .path = "../libtiff" },
        .libjpeg_turbo = .{ .path = "../libjpeg-turbo" },
        .libraw = .{ .path = "../libraw" },
        // LittleCMS 2.18, allyourcodebase's package.
        .lcms2 = .{
            .url = "git+https://github.com/allyourcodebase/lcms2.git?ref=v2.18.0#66c7c0ef0a9bd29a5f78aeff797bf541d0b91624",
            .hash = "lcms2-2.18.0-CNsMs50PAAAbhEQvq2uI5_O2vqgvYXvcDKwFw8QbzKSk",
        },
        // zlib 1.3.2, which LibTIFF and LibRaw link too. The module calls it to compress a TIFF's
        // strips, and names it for its licence.
        .zlib = .{
            .url = "git+https://github.com/allyourcodebase/zlib.git?ref=1.3.2#d3b5519d3b73616a6bfece0712f080029d2a9244",
            .hash = "zlib-1.3.2-ZZQ7lc8NAAAHm9MDfplvwoesXvk4tVm6VCsiI8KnIbT0",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "c.h",
        "jpeg_shim.h",
        "jpeg_shim.c",
    },
}
