diff --git a/backend/epson2-ops.c b/backend/epson2-ops.c
index 61930f6..9be1212 100644
--- a/backend/epson2-ops.c
+++ b/backend/epson2-ops.c
@@ -1371,13 +1371,15 @@ e2_init_parameters(Epson_Scanner * s)
 		s->params.bytes_per_line =
 			3 * s->params.pixels_per_line * bytes_per_pixel;
 		break;
-#ifdef SANE_FRAME_IR
 	case MODE_INFRARED:
-		s->params.format = SANE_FRAME_IR;
+		/* SANE has no infrared frame type yet (SANE_FRAME_IR is
+		 * reserved in sane.h but not defined), so the infrared pass
+		 * comes as a gray frame, as pixma's does (changed for
+		 * minilab, November 2026). */
+		s->params.format = SANE_FRAME_GRAY;
 		s->params.bytes_per_line =
 			s->params.pixels_per_line * s->params.depth / 8;
 		break;
-#endif
 	}
 
 	if (s->params.bytes_per_line == 0)
